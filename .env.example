REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM switch: ollama | google
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=900

# Google AI Studio / any cloud provider's model (used when LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-3-12b-it
GOOGLE_TEMPERATURE=0.3

API_BASE_URL=http://localhost:8000
API_URL=http://localhost:8000
ANALYZE_CACHE_TTL_SECONDS=3600
# Repeat ticker within TTL returns cached analyze (exact same agent text).
# UI "Refresh analysis" sends force_refresh=true to bypass Redis and re-run LLMs.

MLFLOW_TRACKING_URI=sqlite:///mlflow.db
DAGSHUB_USER_NAME=
DAGSHUB_REPO_NAME=
DAGSHUB_TOKEN=

FMI_API_KEY=
# Optional Finnhub token (same value as FMI_API_KEY). Company-news is preferred over Yahoo.
FINNHUB_API_KEY=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

ALLOW_SYSTEM_RESET=false
LOG_LEVEL=INFO
# json (default, production) | text (local human-readable, still no ANSI)
LOG_FORMAT=json
